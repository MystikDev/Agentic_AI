# Copy to `.env` and fill in. NEVER commit the real .env.
# Your Anthropic API key — lives ONLY on the server, never in the mobile app.
ANTHROPIC_API_KEY=sk-ant-...

# Port the API listens on.
PORT=8787

# Comma-separated list of allowed origins for CORS (the Expo dev client, your web build, etc.)
# Use * only for local development.
ALLOWED_ORIGINS=*
