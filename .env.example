# Copy this file to .env and fill in your keys.
# yfinance needs no key.

ANTHROPIC_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=

# Plaid (optional, only needed for live bank sync).
# PLAID_ENV: sandbox | development | production
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Optional: override the Claude model used by the advisor CLI.
ADVISOR_MODEL=claude-opus-4-7
